# Copy to .env and fill in, or run: python scripts/setup.py
# Never commit .env. Everything below except AGENT_API_TOKEN and LLM_API_KEY is optional.

# --- API ------------------------------------------------------------------------------
# Token every client sends as "Authorization: Bearer ...".
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=change-me

# --- Language model -------------------------------------------------------------------
# anthropic is the provider shipped; see AGENTS.md to add another one.
# ANTHROPIC_API_KEY and ANTHROPIC_MODEL are accepted as aliases.
LLM_PROVIDER=anthropic
LLM_API_KEY=your-api-key
LLM_MODEL=claude-sonnet-5-5
MAX_TOKENS=1024
MAX_TOOL_ITERATIONS=8

# --- Assistant ------------------------------------------------------------------------
ASSISTANT_NAME=Assistant
# en or fr (see src/intelligent_home_agent/i18n.py to add a language)
LANGUAGE=en
TIMEZONE=UTC
CONVERSATION_TTL_SECONDS=300

# --- Home location: weather, travel time, outdoor forecasts, local web results ---------
HOME_LATITUDE=
HOME_LONGITUDE=
HOME_CITY=
# Two-letter country code, e.g. US, FR
HOME_COUNTRY=

# --- Morning briefing and evening recap ------------------------------------------------
# Any of: calendar, travel, mail, pull_requests, reminders, weather, activities
BRIEF_SECTIONS=calendar,travel,mail,pull_requests,reminders,weather,activities
# off, short or detailed
WEATHER_DETAIL=short

# --- Outdoor activities (Open-Meteo, no key) -------------------------------------------
# Comma-separated, names or aliases: surf, wingfoil, kitesurf, windsurf, sailing, cycling,
# running, hiking, skiing, climbing, golf, outdoors ("I go out a lot").
OUTDOOR_ACTIVITIES=
# Open-Meteo model for wind; best_match everywhere, regional models can be sharper.
WIND_MODEL=best_match
# Wind-sport spots, JSON on one line. directions: compass points the spot works with
# (N, NNE, NE ... NW, NNW); [] means any.
WIND_SPOTS=[]
# WIND_SPOTS=[{"name":"North Beach","latitude":0.0,"longitude":0.0,"directions":["W","SW","NW"],"min_knots":13}]
# Surf spots, JSON on one line. facing: compass point the beach faces, towards the sea.
SURF_SPOTS=[]
# SURF_SPOTS=[{"name":"North Beach","latitude":0.0,"longitude":0.0,"facing":"W","min_wave_m":0.5,"max_wave_m":2.5}]

# --- Home Assistant (optional; without a token the home tools are off) -----------------
# Create the token in HA: Profile > Security > Long-lived access tokens.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# HTTP proxy to reach HA, e.g. a VPN sidecar's outbound proxy (see docs/deployment.md).
HA_PROXY_URL=
HA_EXPOSED_DOMAINS=light,switch,cover,climate,fan,media_player,scene,script,vacuum,sensor,binary_sensor,weather,lock,alarm_control_panel
# Actions on these domains need a spoken yes in a later message.
HA_SENSITIVE_DOMAINS=lock,alarm_control_panel,cover
HA_ENTITY_DENYLIST=

# --- Web search (separate model request with the provider's search tool) --------------
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MODEL=claude-haiku-5-5
WEB_SEARCH_MAX_USES=3

# --- Calendar, read-only over CalDAV (use an app-specific password) --------------------
# e.g. https://caldav.icloud.com, https://caldav.fastmail.com/dav/, a Nextcloud DAV URL
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Only these calendars (comma-separated names); empty means all.
CALDAV_CALENDARS=

# --- Mailboxes, read-only over IMAP (nothing is marked as read) ------------------------
# JSON on one line; use app passwords.
MAIL_ACCOUNTS=[]
# MAIL_ACCOUNTS=[{"name":"Personal","host":"imap.example.com","username":"me@example.com","password":"app-password"}]

# --- Travel time from home (OpenStreetMap, no key; driving, no live traffic) -----------
TRAVEL_ENABLED=true
TRAVEL_MARGIN_MINUTES=10

# --- GitHub ----------------------------------------------------------------------------
# Classic token with the "repo" scope (fine-grained tokens only cover one owner).
GITHUB_TOKEN=
# Reminders left with a coding assistant, one Markdown file each: owner/repo and folder.
ASSISTANT_REMINDERS_REPO=
ASSISTANT_REMINDERS_PATH=reminders

# --- Push notifications through ntfy (optional) ----------------------------------------
# Full topic URL; on the public server, use a long random topic name.
NTFY_URL=
NTFY_TOKEN=
