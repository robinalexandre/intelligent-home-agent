# Copy to .env and fill in, or run: python scripts/setup.py
# Never commit .env. Everything below except AGENT_API_TOKEN and LLM_API_KEY is optional
# (and LLM_API_KEY too with a Claude subscription, see ENGINE below).

# --- API ------------------------------------------------------------------------------
# Token every client sends as "Authorization: Bearer ...".
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_TOKEN=change-me

# --- Docker Compose: how the agent is reached (docs/setup.md, step 4) -------------------
# Read by `docker compose`, not by the agent. Nothing set: this machine only, 127.0.0.1:8000.
# The home network, plain HTTP (never on a machine with a public address):
# AGENT_BIND=0.0.0.0
# One file per choice, joined with ":" (caddy, traefik, tailscale, cloudflared, ollama):
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:compose/caddy.yml
# caddy and traefik: the domain name of the agent.
# AGENT_DOMAIN=agent.example.com
# traefik: the Docker network it shares with its services, its certificate resolver.
# TRAEFIK_NETWORK=proxy
# TRAEFIK_CERTRESOLVER=letsencrypt
# tailscale: an auth key, the node's name, and "funnel" for a public address.
# TS_AUTHKEY=
# TS_HOSTNAME=home-agent
# TS_SERVE=serve
# cloudflared: the tunnel's token.
# TUNNEL_TOKEN=

# --- Language model (docs/setup.md, step 2) --------------------------------------------
# anthropic, openai, mistral, gemini, groq, openrouter, ollama, lmstudio, or
# openai-compatible (any server that speaks the OpenAI chat API, with LLM_BASE_URL).
# ANTHROPIC_API_KEY and ANTHROPIC_MODEL are accepted as aliases.
LLM_PROVIDER=anthropic
# Not needed by ollama, lmstudio and most openai-compatible servers.
LLM_API_KEY=your-api-key
# Required, except for anthropic (claude-sonnet-5-5). It must support tool calling.
LLM_MODEL=
# The server's address, usually ending in /v1: required for openai-compatible, optional
# for the others (e.g. Ollama on the Docker host: http://host.docker.internal:11434/v1).
LLM_BASE_URL=
MAX_TOKENS=1024
MAX_TOOL_ITERATIONS=8
# A reply read in a chat ("display": "chat") may be longer and take more rounds of tools.
MAX_CHAT_TOKENS=4096
MAX_CHAT_TOOL_ITERATIONS=30

# --- Claude on your Claude subscription instead of the API (docs/subscription.md) -------
# Only with LLM_PROVIDER=anthropic. api: every reply is an API request. subscription:
# Claude Code, inside the agent, answers on your own Claude plan, signed in with the token
# that `claude setup-token` prints; slower to start (fine in a chat, not for voice). Needs
# the "subscription" extra: EXTRAS=documents,subscription with Docker (then rebuild), or
# pip install ".[subscription]".
# ENGINE=subscription
# CLAUDE_CODE_OAUTH_TOKEN=
# LLM_API_KEY may then stay empty. With a key, the API takes what the subscription can't
# (a file to read, a usage limit, an error); without one, those turns say so.
# Empty: LLM_MODEL.
# SUBSCRIPTION_MODEL=
# Where the subscription answers, comma-separated among voice, notification, chat; the
# API answers the others (without a key, the subscription answers everywhere).
# SUBSCRIPTION_DISPLAYS=chat

# --- Assistant ------------------------------------------------------------------------
ASSISTANT_NAME=Assistant
# How long a conversation is remembered (seconds), with the files sent in it and what
# waits for your yes: a few minutes for voice, longer for a chat ("display": "chat").
CONVERSATION_TTL_SECONDS=300
CHAT_CONVERSATION_TTL_SECONDS=43200
# What the assistant calls you (empty: no name).
USER_NAME=
# en or fr (see src/intelligent_home_agent/i18n.py to add a language)
LANGUAGE=en
TIMEZONE=UTC
CONVERSATION_TTL_SECONDS=300

# --- Home location: weather, travel time, outdoor forecasts, local web results ---------
HOME_LATITUDE=
HOME_LONGITUDE=
HOME_CITY=
# Two-letter country code, e.g. US, FR
HOME_COUNTRY=

# --- Morning briefing and evening recap ------------------------------------------------
# Any of: calendar, travel, mail, pull_requests, reminders, weather, activities
BRIEF_SECTIONS=calendar,travel,mail,pull_requests,reminders,weather,activities
# off, short or detailed
WEATHER_DETAIL=short

# --- Outdoor activities (Open-Meteo, no key) -------------------------------------------
# Comma-separated, names or aliases: surf, wingfoil, kitesurf, windsurf, sailing, cycling,
# running, hiking, skiing, climbing, golf, outdoors ("I go out a lot").
OUTDOOR_ACTIVITIES=
# Open-Meteo model for wind; best_match everywhere, regional models can be sharper.
WIND_MODEL=best_match
# Wind-sport spots, JSON on one line. directions: compass points the spot works with
# (N, NNE, NE ... NW, NNW); [] means any.
WIND_SPOTS=[]
# WIND_SPOTS=[{"name":"North Beach","latitude":0.0,"longitude":0.0,"directions":["W","SW","NW"],"min_knots":13}]
# Surf spots, JSON on one line. facing: compass point the beach faces, towards the sea.
SURF_SPOTS=[]
# SURF_SPOTS=[{"name":"North Beach","latitude":0.0,"longitude":0.0,"facing":"W","min_wave_m":0.5,"max_wave_m":2.5}]
# A spot may carry "active_from" and "active_until" (2027-06-01): the days you are near it.
# Where home is from a given day, when you move (else HOME_LATITUDE/HOME_LONGITUDE):
# HOME_MOVES=[{"active_from":"2027-03-01","latitude":0.0,"longitude":0.0}]
# Wind measured now near the spots, off by default. Any of: openwindmap (community
# beacons, no key, dense in France and the Alps), metar (airports worldwide, no key),
# meteofrance (France, needs the application id below). See docs/outdoor.md.
LIVE_WIND_SOURCES=
LIVE_WIND_RADIUS_KM=20
METEOFRANCE_APPLICATION_ID=
# Activities to be told about when a good window is coming, e.g. surf,cycling (you can
# also just ask the assistant for an alert). They need NTFY_URL below.
ACTIVITY_ALERTS=
# How early at most, in hours (1 to 72), and the hours when nothing is sent.
ACTIVITY_ALERTS_LEAD_HOURS=24
ACTIVITY_ALERTS_QUIET_START=22
ACTIVITY_ALERTS_QUIET_END=8

# --- Home Assistant (optional; without a token the home tools are off) -----------------
# Create the token in HA: Profile > Security > Long-lived access tokens.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# HTTP proxy to reach HA, e.g. a VPN sidecar's outbound proxy (see docs/deployment.md).
HA_PROXY_URL=
HA_EXPOSED_DOMAINS=light,switch,cover,climate,fan,media_player,scene,script,vacuum,sensor,binary_sensor,weather,lock,alarm_control_panel
# Actions on these domains need a spoken yes in a later message.
HA_SENSITIVE_DOMAINS=lock,alarm_control_panel,cover
HA_ENTITY_DENYLIST=

# --- Home devices driven directly, without Home Assistant (docs/home-devices.md) ------
# Philips Hue: the bridge's address at home and an app key (press its button to get one).
HUE_BRIDGE_URL=
HUE_APP_KEY=
# Devialet Phantom speaker: its address; every volume the agent sets is capped.
DEVIALET_URL=
DEVIALET_MAX_VOLUME=70
# HTTP proxy to reach the home network from elsewhere; HA_PROXY_URL when empty.
HOME_PROXY_URL=
# A Google TV / Android TV device (a TV, a projector, a box): scripts/android_tv_pair.py
# writes these three. Needs the android-tv extra (docs/home-devices.md).
ANDROID_TV_HOST=
ANDROID_TV_CLIENT_CERT=
ANDROID_TV_CLIENT_KEY=
ANDROID_TV_MAX_VOLUME=70
# What you call it ("TV", "projector"): used in what the agent says.
ANDROID_TV_NAME=TV
# Apps besides netflix, youtube, prime video and disney+, as JSON; a null link opens the
# app from its store page (only for an installed app).
# ANDROID_TV_APPS={"my tv app": {"package": "com.example.tv", "link": null}}
# The live TV app that takes a channel number typed on the remote, and names for numbers.
# ANDROID_TV_CHANNEL_APP=my tv app
# ANDROID_TV_CHANNELS={"news one": 1, "sports two": 12}
# Apple TV and HomePods (the apple extra): what scripts/apple_devices.py prints.
APPLE_DEVICES=
APPLE_TV_COMPANION_CREDENTIALS=
APPLE_TV_AIRPLAY_CREDENTIALS=
# Nuki smart lock: a Nuki Web API token (web.nuki.io > API).
NUKI_API_TOKEN=
# Proof asked before a door opens, from scripts/unlock_codes_setup.py: an authenticator
# app's secret and/or a secret phrase. Neither: opening waits for your yes each time.
UNLOCK_TOTP_SECRET=
UNLOCK_PHRASE=
# Netatmo cameras, weather station, thermostat: scripts/netatmo_login.py writes these.
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
# PetKit feeder and litter box (the petkit extra): a second PetKit account the devices are
# shared with, and its country code (HOME_COUNTRY when empty).
PETKIT_USERNAME=
PETKIT_PASSWORD=
PETKIT_REGION=
# With NTFY_URL: a push when litter or food gets under these levels (%) or the waste bin
# is full (again every PETKIT_BIN_REMIND_MINUTES), looked at every PETKIT_CHECK_MINUTES,
# never between PETKIT_QUIET_START and PETKIT_QUIET_END (hours).
PETKIT_ALERTS=true
PETKIT_LITTER_ALERT_PERCENT=50
PETKIT_FOOD_ALERT_PERCENT=45
PETKIT_BIN_REMIND_MINUTES=120
PETKIT_CHECK_MINUTES=180
PETKIT_QUIET_START=22
PETKIT_QUIET_END=8
# POST /v1/departure (the phone's "when I leave home" automation): says what is still
# unlocked, on or playing, and offers to fix it.
DEPARTURE_CHECK=true

# --- Health: Withings scale, read-only (docs/health.md) --------------------------------
# scripts/withings_login.py writes these three.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REFRESH_TOKEN=

# --- Parcels noted from shipping emails (on with MAIL_ACCOUNTS) -------------------------
DELIVERIES_ENABLED=true

# --- Web search (a separate model request that only sees the query) -------------------
WEB_SEARCH_ENABLED=true
# auto: the provider's own search tool with anthropic (native), duckduckgo with the others.
# duckduckgo: no key, best effort. searxng: your own instance (WEB_SEARCH_URL, or
# compose/searxng.yml). brave, tavily: WEB_SEARCH_API_KEY. With these four, the agent
# fetches the results and your model writes the answer, whatever the provider.
WEB_SEARCH_BACKEND=auto
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=
# Empty: claude-haiku-5-5 with native, LLM_MODEL otherwise.
WEB_SEARCH_MODEL=
# native: searches per question. The others: results read per search.
WEB_SEARCH_MAX_USES=3
WEB_SEARCH_RESULTS=5
# compose/searxng.yml: python3 -c "import secrets; print(secrets.token_hex(32))"
# SEARXNG_SECRET=

# --- Web pages and investigations (docs/web.md) -----------------------------------------
# Opening public pages and downloading public documents (no logins). Private and internal
# addresses are always refused.
WEB_PAGES_ENABLED=true
# After a request read emails, the calendar or other private content, only the public
# services of HOME_COUNTRY (government sites: the list is in docs/web.md) can still be
# opened, since a URL can carry data out. Add your own here, comma separated, subdomains
# included: e.g. a tide table, a weather service, your town's site.
WEB_TRUSTED_DOMAINS=
# Investigating a photo, a document, a link or a site: file metadata, a domain's age and
# registrar, archives, certificates, places on OpenStreetMap. No key; lookups go to
# rdap.org, web.archive.org, crt.sh and NOMINATIM_URL.
INVESTIGATIONS_ENABLED=false
# The agent's own public address, when it has one (e.g. https://agent.example.com): lets
# it put a photo you sent online for 15 minutes, for a reverse image search. Empty: no
# reverse image search.
PUBLIC_URL=

# --- Remote browser: sites behind your login (docs/browser.md; Docker only) -------------
# A real Chrome next to the agent: you log into a site in it from a link, the agent then
# opens pages, clicks and downloads there. Add compose/browser.yml to COMPOSE_FILE and
# "browser" to EXTRAS, then choose how its page is reached (docs/browser.md):
# - behind a login page, on your domain: compose/browser-login.yml plus
#   compose/browser-caddy.yml or compose/browser-traefik.yml, and the AUTH_ lines;
# - on your Tailscale network only: BROWSER_GATE=tailnet and TS_SERVE=serve-browser.
# The address of the browser's page, sent to you as the login link. Empty: no browser.
BROWSER_PUBLIC_URL=
# BROWSER_GATE=tailnet
# The page and its login page (Authelia): two names under AUTH_COOKIE_DOMAIN, e.g.
# browser.example.com and auth.example.com under example.com. The three secrets:
# `openssl rand -hex 32` each; then scripts/browser-auth.sh user sets the password.
BROWSER_DOMAIN=
AUTH_DOMAIN=
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_SECRET=
AUTH_STORAGE_KEY=
AUTH_JWT_SECRET=
# Pages seen from another country, through a VPN subscription (compose/vpn.yml, after
# compose/browser.yml): gluetun's name for your provider (mullvad, protonvpn, nordvpn,
# surfshark...), a key for its control server (`openssl rand -hex 32`), and the
# credentials your provider uses. Empty: browser_open takes no country.
VPN_SERVICE_PROVIDER=
VPN_CONTROL_KEY=
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# OPENVPN_USER=
# OPENVPN_PASSWORD=

# --- If you use Apple devices: Reminders, Notes and Find My (docs/apple.md) -------------
# Apple has no public API for them: the agent goes through icloud.com's web services,
# with a login you type once in its container (Apple ID password + 2FA code; only the
# session is kept, never the password) and renew when Apple ends it. Needs the
# "icloud" extra: EXTRAS=documents,icloud with Docker, or pip install ".[icloud]".
# Empty: none of them; reminders are then created on the phone by the Siri Shortcut.
ICLOUD_APPLE_ID=
# Only these Reminders lists (comma-separated names); empty means all.
ICLOUD_REMINDER_LISTS=
# Where a new reminder goes without a list; empty: the list with the most open ones.
ICLOUD_REMINDERS_DEFAULT_LIST=
# false leaves Notes (read-only) or Find My (where devices are, battery, a sound) out.
ICLOUD_NOTES=true
ICLOUD_FIND_MY=true

# --- Calendar over CalDAV (use an app password; docs/mail-calendar.md) -----------------
# e.g. https://caldav.icloud.com, https://caldav.fastmail.com/dav/, a Nextcloud DAV URL
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Only these calendars (comma-separated names); empty means all.
CALDAV_CALENDARS=
# true: the agent may add events (after it read an email, it asks you first). It never
# changes or deletes one.
CALDAV_WRITE=false
# The calendar new events go to, by name; empty: the one the server gives as default.
CALDAV_DEFAULT_CALENDAR=

# --- Contacts' birthdays over CardDAV, shown as all-day events (read-only) -------------
# e.g. https://contacts.icloud.com, https://carddav.fastmail.com/dav/, a Nextcloud DAV URL
CARDDAV_URL=
# Empty: the CalDAV username and password.
CARDDAV_USERNAME=
CARDDAV_PASSWORD=

# --- Mailboxes over IMAP (docs/mail-calendar.md) ---------------------------------------
# JSON on one line; use app passwords. Reading marks nothing as read. An account with
# "write":true also takes drafts, flags and filing into your own folders; nothing is ever
# sent or deleted. Optional per account: "address" (From of the drafts when the username
# isn't one), "drafts", "sent", "trash" (folder names, when they aren't found by themselves).
MAIL_ACCOUNTS=[]
# MAIL_ACCOUNTS=[{"name":"Personal","host":"imap.example.com","username":"me@example.com","password":"app-password","write":true}]

# --- Travel time from home (OpenStreetMap, no key; driving, no live traffic) -----------
TRAVEL_ENABLED=true
TRAVEL_MARGIN_MINUTES=10

# --- GitHub ----------------------------------------------------------------------------
# Classic token with the "repo" scope (fine-grained tokens only cover one owner).
GITHUB_TOKEN=
# Let the agent list your repositories, read and search their files and check their
# dependencies for known flaws (OSV.dev). Read-only.
GITHUB_REPOSITORIES=false

# --- Notes repository: notes for your coding sessions (docs/tasks.md) -------------------
# owner/repo of a private repository with reminders (one Markdown file each) and handoff
# notes. One way to have one: the config sync of claude-code-kit. Empty: none.
NOTES_REPO=
ASSISTANT_REMINDERS_PATH=reminders
HANDOFFS_PATH=handoffs
# Let the agent leave reminders and handoff notes there and close reminders; GITHUB_TOKEN
# must then be allowed to write the repository's contents. false: only read.
NOTES_WRITE=false
# Optional: when the repository encrypts folders with git-crypt, the key it exported, as
# one base64 line. Not needed when MEMORY_CRYPT_KEY is the key of the same repository.
NOTES_CRYPT_KEY=

# --- Tasks the agent runs by itself (docs/tasks.md) -------------------------------------
# A reminder at a time, a check every week... sent as a push: they need NTFY_URL below.
# local: Markdown files in DATA_DIR/tasks; nothing to set up.
# github: a folder of NOTES_REPO, which you can also write to from any computer.
# off: no tasks.
TASKS_STORE=local
# The folder. Empty: tasks in DATA_DIR (local), or <assistant>/tasks (github).
TASKS_PATH=
# Send the morning briefing and the evening recap every day at that local time (07:30).
# Empty: only when asked.
MORNING_BRIEFING_AT=
EVENING_RECAP_AT=

# --- Connectors: any service with an MCP server (a bank, a hosting provider...) --------
# JSON list on one line; docs/connectors.md. "writes": "off" (default) or "confirm".
# For a service that needs a browser login: python scripts/mcp_login.py <name> <url>
MCP_SERVERS=[]
# MCP_SERVERS=[{"name":"bank","label":"My Bank","url":"https://mcp.bank.example/mcp","token":"your-token"}]

# --- Documents, PDFs and pictures (docs/documents.md) -----------------------------------
# PDFs written from the conversation, PDF forms filled, pages copied and merged, drawings
# and animations. Nothing leaves the machine. Needs the "documents" extra, which the
# Docker image installs (pip install ".[documents]" otherwise).
DOCUMENTS_ENABLED=true
# a4, letter, or auto: US Letter where it is the usual paper (from HOME_COUNTRY), else A4.
PAPER_SIZE=auto
# A folder with the fonts for PDFs and drawings: a Regular and a Bold .ttf or .otf of one
# family. Empty: DejaVu Sans (Latin, Greek, Cyrillic), installed in the Docker image.
PDF_FONT_DIR=
# Photos of gym and home exercises, from a public-domain bank read on GitHub.
EXERCISE_PHOTOS_ENABLED=false
# Calculations and charts run as Python in the model provider's sandbox, billed there.
# Only with LLM_PROVIDER=anthropic. CODE_EXECUTION_MODEL: empty for LLM_MODEL.
CODE_EXECUTION_ENABLED=false
# CODE_EXECUTION_MODEL=

# --- Pictures and short videos made by an AI model, billed on that provider's account ---
# A language model writes no pictures. Either key is enough; both: the model picks, and
# GENERATION_DEFAULT_PROVIDER (gemini or openai) says which one when it doesn't.
# Google AI Studio key: Gemini's image model and Veo for videos.
GENERATION_GEMINI_API_KEY=
# GENERATION_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GENERATION_GEMINI_VIDEO_MODEL=veo-3.1-lite-generate-001
# OpenAI key: gpt-image and Sora. With GENERATION_OPENAI_BASE_URL, any server that speaks
# OpenAI's images API instead (a local one needs no key).
GENERATION_OPENAI_API_KEY=
# GENERATION_OPENAI_BASE_URL=http://192.168.1.50:8080/v1
# GENERATION_OPENAI_IMAGE_MODEL=gpt-image-2
# GENERATION_OPENAI_VIDEO_MODEL=sora-2
# A model set to "off": no picture, or no video, from that provider.
# GENERATION_DEFAULT_PROVIDER=
# The most one request may make, so a loop can't run up the bill.
GENERATION_MAX_IMAGES=6
GENERATION_MAX_VIDEOS=2

# --- What the agent keeps on disk -------------------------------------------------------
# Where it keeps what must survive a restart: the journal, a connector's renewed login.
# In Docker this is the agent_data volume (/app/data); leave it as it is there.
DATA_DIR=data
# The journal: one line per request (what was asked, the tools called, the reply; no reply
# and no tool arguments for a request that read emails, files or the web), one file per
# day in DATA_DIR/journal, removed after this many days. 0: no journal.
JOURNAL_KEEP_DAYS=365
# A chat ("display": "chat") survives a restart: what was said and what waits for your yes
# are saved in DATA_DIR/conversations, and the files sent in it or made by the agent in
# DATA_DIR/files for this many days. 0: files stay in memory only.
FILES_KEEP_DAYS=30

# --- Memory: what the assistant remembers about you (docs/memory.md) --------------------
# Facts you tell it to remember, and the steps of jobs that worked, in two Markdown files
# you can read and edit.
# local: in DATA_DIR (memory.md, procedures.md); nothing to set up.
# github: in a repository of yours, editable from any computer; needs MEMORY_REPO and a
#   GITHUB_TOKEN allowed to write its contents.
# off: it remembers nothing between conversations.
MEMORY_STORE=local
# owner/repo, for MEMORY_STORE=github.
MEMORY_REPO=
# Where the two files are. Empty: memory.md and procedures.md in DATA_DIR (local), or in a
# folder named after the assistant (github: ASSISTANT_NAME=Nova keeps nova/memory.md).
MEMORY_PATH=
PROCEDURES_PATH=
# Optional, github only: when the repository encrypts that folder with git-crypt, the key
# it exported, as one base64 line (git-crypt export-key key && base64 -w0 key).
MEMORY_CRYPT_KEY=

# --- Knowledge base: your Markdown notes, searched by the agent (docs/knowledge.md) -----
# With compose/kb.yml, which sets KB_URL. KB_TOKEN: a shared secret you generate.
# KB_REPO: owner/repo of the notes. KB_GITHUB_TOKEN: read access to it.
KB_URL=
KB_TOKEN=
# KB_REPO=
# KB_GITHUB_TOKEN=

# --- File drives: Google Drive, iCloud Drive, OneDrive, Dropbox, a NAS, S3... -----------
# Through an rclone sidecar (compose/drive.yml, which sets DRIVE_URL): docs/drives.md says
# which services work and how each one is logged in. Nothing set: no drive tools.
DRIVE_URL=
# A shared secret between the agent and the sidecar, e.g. openssl rand -hex 24.
DRIVE_PASSWORD=
# The drives, a JSON list. name: what the tools call it; remote: as in rclone's config,
# with an optional folder; backend: rclone's type of the storage, for better advice when
# a login fails; label: what you call it; read_only: true to only list, search and read;
# content: false to leave its files' text out of the search by content.
DRIVES=[]
# DRIVES=[{"name":"gdrive","remote":"gdrive:","backend":"drive"},{"name":"nas","label":"Home NAS","remote":"nas:Documents","backend":"sftp","read_only":true}]
# Hours before the index of file names is rebuilt.
# DRIVE_INDEX_HOURS=24
# What the agent deletes is first copied to DATA_DIR/drive-trash: days kept, biggest item
# copied and most the trash may hold (MB). Beyond, a deletion asks to go without a copy.
# DRIVE_TRASH_DAYS=30
# DRIVE_TRASH_MAX_ITEM_MB=1024
# DRIVE_TRASH_MAX_TOTAL_MB=5120
# Search inside the files (PDF, office documents, text): each is downloaded once.
# DRIVE_CONTENT=true
# Scanned PDFs: model = the model reads them, a few per hour, each a paid request (only
# with LLM_PROVIDER=anthropic today; elsewhere they stay listed by name). off: by name only.
# DRIVE_OCR=off
# DRIVE_OCR_MODEL=

# --- Push notifications through ntfy (optional) ----------------------------------------
# Full topic URL; on the public server, use a long random topic name.
NTFY_URL=
NTFY_TOKEN=
